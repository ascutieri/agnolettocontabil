---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';

const linkClass = 'text-sm font-medium text-ink-100 transition-colors hover:text-gold-300';
---

<footer class="bg-brand-950 text-ink-300">
	<div class="mx-auto flex max-w-6xl flex-col gap-10 px-5 py-12 sm:flex-row sm:items-center sm:justify-between">
		<div class="order-2 sm:order-1">
			<ul class="flex flex-wrap gap-x-6 gap-y-2">
				{
					nav.map((item) => (
						<li>
							<a href={item.href} class={linkClass}>
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a href={site.whatsapp} target="_blank" rel="noopener" class={linkClass}>
						WhatsApp
					</a>
				</li>
			</ul>
			<p class="mt-6 text-xs text-ink-400">
				© {new Date().getFullYear()}
				{site.name}. Todos os direitos reservados.
			</p>
		</div>
		<a href="/" aria-label="Agnoletto Contabilidade - Início" class="order-1 text-3xl sm:order-2">
			<Logo variant="light" />
		</a>
	</div>
	<div class="h-1 bg-gold-500"></div>
</footer>
