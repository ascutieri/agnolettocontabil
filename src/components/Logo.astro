---
import { Image } from 'astro:assets';
import logoColor from '../assets/logo-color.png';
import logoWhite from '../assets/logo-white.png';

interface Props {
	class?: string;
	/** "color" para fundos claros, "light" para fundos escuros */
	variant?: 'color' | 'light';
	width?: number;
}
const { class: className, variant = 'color', width = 200 } = Astro.props;
---

<Image
	src={variant === 'light' ? logoWhite : logoColor}
	alt="Agnoletto Contabilidade"
	width={width}
	class={className}
	loading="eager"
/>
